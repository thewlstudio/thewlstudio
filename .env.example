# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-03-01

# Site URL (used for SEO: canonical URLs, OG tags, JSON-LD)
# 아직 실제 도메인을 구매하지 않았다면 실제 배포 주소를 넣으세요 (예: Vercel 기본 도메인)
NEXT_PUBLIC_SITE_URL=https://whitelightstudio.vercel.app

# Sanity API Token (optional — required for draft/preview mode)
SANITY_API_READ_TOKEN=

# --- /manage 관리 화면 (강사·작업물 등 간편 편집 UI) ---

# 공유 비밀번호 로그인에 쓰는 비밀번호. 원하는 값으로 정하세요.
MANAGE_PASSWORD=

# 세션 쿠키 서명용 시크릿. 아래 명령으로 생성:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANAGE_SECRET=

# Sanity 쓰기 토큰 — /manage에서 저장 기능을 쓰려면 필요.
# sanity.io/manage → 프로젝트 선택 → API → Tokens → Add API token (Editor 권한)
# 한 번만 표시되니 발급 즉시 복사해서 저장하세요.
SANITY_API_WRITE_TOKEN=
